# LLM backend
# ccswitch = follow the provider currently selected in CC Switch's Codex tab
# codex_cli = use the Codex CLI login session (ChatGPT plan)
# lmstudio = use a model loaded in the local LM Studio server
# openai_compatible = optional third-party /v1/chat/completions endpoint
LLM_PROVIDER=ccswitch
CCSWITCH_BASE_URL=http://127.0.0.1:15721/v1
# Leave blank to follow the model written by CC Switch to ~/.codex/config.toml.
CCSWITCH_MODEL=
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Leave blank to automatically use the first model returned by LM Studio /v1/models.
LMSTUDIO_MODEL=
# LM Studio normally does not validate this value; lm-studio is sufficient.
LMSTUDIO_API_KEY=lm-studio

# WeChat 4.x targets. Use exact contact remark/name shown in WeChat.
# 最多 3 个联系人，用英文逗号、中文逗号、分号或换行分隔。
WECHAT_TARGETS=
# 旧版单联系人配置仍兼容；WECHAT_TARGETS 有值时优先使用它。
WECHAT_TARGET=
# 优先使用无鼠标 UIAutomation 发送；UIA 不可用时默认不回退坐标点击。
WECHAT_BACKGROUND_MODE=true
WECHAT_ALLOW_MOUSE_FALLBACK=false

# false = print generated replies without sending; true = send automatically.
AUTO_SEND=false

# Safety and behavior
REPLY_COOLDOWN_SECONDS=0
MAX_HISTORY_MESSAGES=100
MAX_REPLY_CHARS=500
MAX_INPUT_CHARS=4000
DATABASE_PATH=data/wechat_autoreply.sqlite3
LOG_LEVEL=INFO

# Persona/instructions. Keep the bot transparent and avoid commitments or sensitive actions.
SYSTEM_PROMPT=你是我的微信聊天助手。用自然、简洁、友好的中文回复。不要编造事实，不要代表我做金钱、合同、账号、安全或其他重要承诺；遇到不确定或敏感问题时，明确说明需要本人确认。除非对方明确要求，不要长篇大论。
# 可选：指向离线生成的语气画像 JSON，例如 data/contacts/李心柔（12.12）/persona.json
PERSONA_PATH=
# 本地聊天记忆仅在 LLM_PROVIDER=lmstudio 时生效；不会发送到 CC Switch、Codex 或远程兼容接口。
LOCAL_MEMORY_ENABLED=false
LOCAL_MEMORY_PATH=data/raw/my_wechat_messages.jsonl
LOCAL_MEMORY_MAX_RESULTS=6
LOCAL_MEMORY_MAX_CHARS=800
# 启用图片下载与视觉理解；需要模型支持图片输入。
IMAGE_RECOGNITION_ENABLED=false
# 图片缓存自动清理：默认保留 7 天，最多占用 512 MB，每小时检查一次。
MEDIA_RETENTION_DAYS=7
MEDIA_CACHE_MAX_MB=512
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
